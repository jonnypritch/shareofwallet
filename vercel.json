{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/products",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/products/",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/no-code-ai-for-business",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/no-code-ai-for-business/",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/10x-faster-demand-planning-software",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/10x-faster-demand-planning-software/",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/insights/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/insights/(.*)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/ai-for-business/:slug*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/private/:slug*",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog-pages/:slug.html"
    },
    {
      "source": "/features",
      "destination": "/prerender/features.html"
    },
    {
      "source": "/solutions/builders-merchants",
      "destination": "/prerender/solutions-builders.html"
    },
    {
      "source": "/solutions/electrical-wholesale",
      "destination": "/prerender/solutions-electrical.html"
    },
    {
      "source": "/solutions/plumbers-merchants",
      "destination": "/prerender/solutions-plumbers.html"
    },
    {
      "source": "/solutions/tool-hire",
      "destination": "/prerender/solutions-tool-hire.html"
    },
    {
      "source": "/solutions/foodservice-wholesale",
      "destination": "/prerender/solutions-foodservice.html"
    },
    {
      "source": "/pricing",
      "destination": "/prerender/pricing.html"
    },
    {
      "source": "/about",
      "destination": "/prerender/about.html"
    },
    {
      "source": "/contact",
      "destination": "/prerender/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/prerender/faq.html"
    },
    {
      "source": "/blog",
      "destination": "/prerender/blog.html"
    },
    {
      "source": "/privacy",
      "destination": "/prerender/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
